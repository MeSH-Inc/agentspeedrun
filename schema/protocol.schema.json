{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "description": "Everything that crosses the plugin ↔ daemon boundary, for schema export.",
  "type": "object",
  "properties": {
    "event": {
      "$ref": "#/$defs/Event"
    },
    "append_request": {
      "$ref": "#/$defs/AppendRequest"
    },
    "project_append_request": {
      "$ref": "#/$defs/ProjectAppendRequest"
    },
    "append_response": {
      "$ref": "#/$defs/AppendResponse"
    },
    "prompt_request": {
      "$ref": "#/$defs/PromptRequest"
    },
    "prompt_response": {
      "$ref": "#/$defs/PromptResponse"
    },
    "active_run_response": {
      "$ref": "#/$defs/ActiveRunResponse"
    },
    "categories_response": {
      "$ref": "#/$defs/CategoriesResponse"
    },
    "chain_report": {
      "$ref": "#/$defs/ChainReport"
    },
    "live_snapshot": {
      "$ref": "#/$defs/LiveSnapshot"
    },
    "error_body": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "event",
    "append_request",
    "project_append_request",
    "append_response",
    "prompt_request",
    "prompt_response",
    "active_run_response",
    "categories_response",
    "chain_report",
    "live_snapshot",
    "error_body"
  ],
  "$defs": {
    "Event": {
      "description": "A single immutable fact in a run's log, as stored by the daemon.\n\n`seq`, `recorded_at`, `device_id`, `prev_hash` and `hash` are assigned by\nthe daemon at append time; clients only supply `event_id` (their\nidempotency key), `occurred_at` and `payload`.",
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "description": "Position in the run's log, starting at 1. Gapless.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "device_id": {
          "type": "string"
        },
        "occurred_at": {
          "description": "When the fact happened according to the client clock.",
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "description": "When the daemon persisted it.",
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/EventPayload"
        },
        "prev_hash": {
          "description": "Hash of the previous event in this run; `None` only for `seq == 1`.",
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "description": "sha256 over the canonical JSON of this event without `hash`.",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "schema_version",
        "run_id",
        "seq",
        "device_id",
        "occurred_at",
        "recorded_at",
        "payload",
        "hash"
      ]
    },
    "EventPayload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run_started"
            },
            "project_id": {
              "type": "string"
            },
            "project_root": {
              "type": [
                "string",
                "null"
              ]
            },
            "category_id": {
              "type": "string"
            },
            "category_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "project_id",
            "category_id",
            "category_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "prompt_submitted"
            },
            "session_id": {
              "type": "string"
            },
            "host": {
              "description": "Which tool the prompt came from, e.g. `claude-code`, `opencode`.",
              "type": "string"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "content": {
              "type": "string"
            },
            "redacted": {
              "description": "True when secret redaction changed `content`.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "session_id",
            "host",
            "content",
            "redacted"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent_turn_started"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent_turn_ended"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "milestone_proposed"
            },
            "milestone_id": {
              "type": "string"
            },
            "origin": {
              "$ref": "#/$defs/MilestoneOrigin"
            },
            "key": {
              "description": "Stable key for category milestones, e.g. `happy-path-demo`.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "required_trust": {
              "$ref": "#/$defs/Trust"
            }
          },
          "required": [
            "type",
            "milestone_id",
            "origin",
            "title",
            "required_trust"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "milestone_accepted"
            },
            "milestone_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "milestone_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "milestone_rejected"
            },
            "milestone_id": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "milestone_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "milestone_reached"
            },
            "milestone_id": {
              "type": "string"
            },
            "trust": {
              "$ref": "#/$defs/Trust"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "default": []
            }
          },
          "required": [
            "type",
            "milestone_id",
            "trust"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "milestone_verified"
            },
            "milestone_id": {
              "type": "string"
            },
            "trust": {
              "$ref": "#/$defs/Trust"
            },
            "verifier": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "default": []
            }
          },
          "required": [
            "type",
            "milestone_id",
            "trust",
            "verifier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "milestone_invalidated"
            },
            "milestone_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "milestone_id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run_paused"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run_resumed"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run_finished"
            },
            "outcome": {
              "$ref": "#/$defs/RunOutcome"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "outcome"
          ]
        }
      ]
    },
    "MilestoneOrigin": {
      "oneOf": [
        {
          "description": "Comes from the run's category ruleset.",
          "type": "string",
          "const": "predefined"
        },
        {
          "description": "Entered by the user.",
          "type": "string",
          "const": "user"
        },
        {
          "description": "Proposed by an agent; must be accepted by the user before it counts.",
          "type": "string",
          "const": "agent_generated"
        }
      ]
    },
    "Trust": {
      "description": "How much a milestone claim can be believed. Ordered weakest → strongest.",
      "type": "string",
      "enum": [
        "self_declared",
        "agent_claimed",
        "evidence_verified"
      ]
    },
    "Evidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "git_commit"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sha"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ci_run"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stripe_event"
            },
            "event_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "event_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "note"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "RunOutcome": {
      "oneOf": [
        {
          "description": "Every category milestone counts.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "The user reset; the next prompt starts a fresh run.",
          "type": "string",
          "const": "abandoned"
        }
      ]
    },
    "AppendRequest": {
      "description": "Append one event to an existing run.",
      "type": "object",
      "properties": {
        "event_id": {
          "description": "Client idempotency key. Retrying with the same id is a no-op.",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/EventPayload"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "payload"
      ]
    },
    "ProjectAppendRequest": {
      "description": "Append one event to whichever run is active for a project. Lets clients\nwrite (and spool while offline) without knowing the run id.",
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/EventPayload"
        }
      },
      "required": [
        "event_id",
        "payload"
      ]
    },
    "AppendResponse": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "inserted": {
          "description": "False when the event_id already existed.",
          "type": "boolean"
        },
        "derived": {
          "description": "Events the daemon appended as a consequence (verification, completion).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "default": []
        },
        "verification": {
          "description": "Result of checking attached evidence, when there was any to check.",
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event",
        "inserted"
      ]
    },
    "VerificationReport": {
      "description": "What the daemon's verifiers concluded about a claim's evidence. A failed\ncheck is not recorded in the log: the claim keeps the trust it was made\nwith, and claiming again re-runs the checks.",
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "verifier": {
          "description": "Verifiers that passed, joined with `+` (e.g. `git+url`), when verified.",
          "type": [
            "string",
            "null"
          ]
        },
        "problems": {
          "description": "Why it was not verified.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "verified"
      ]
    },
    "PromptRequest": {
      "description": "Record a prompt for a project, starting a run if none is active.",
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "project_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "category_id": {
          "description": "Category for a run started by this prompt.",
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "starts_turn": {
          "description": "Also mark an agent turn as started for this session.",
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "event_id",
        "project_id",
        "category_id",
        "session_id",
        "host",
        "content"
      ]
    },
    "PromptResponse": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "run_started": {
          "description": "True when this prompt started a new run.",
          "type": "boolean"
        },
        "event": {
          "$ref": "#/$defs/Event"
        }
      },
      "required": [
        "run_id",
        "run_started",
        "event"
      ]
    },
    "ActiveRunResponse": {
      "type": "object",
      "properties": {
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunView"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RunView": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "project_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "category_id": {
          "type": "string"
        },
        "category_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closed": {
          "description": "No further prompts go to this run: it was abandoned, or reset after completing.",
          "type": "boolean"
        },
        "prompt_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sessions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MilestoneView"
          }
        },
        "timing": {
          "description": "Clocks as of the `now` the view was folded at (or completion).",
          "$ref": "#/$defs/Timing"
        },
        "open_turns": {
          "description": "Sessions with an agent turn in progress.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "paused_since": {
          "description": "Start of the current pause, if paused.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "idle_since": {
          "description": "Start of the current gap between agent turns, if the run is live, unpaused and no turn is open.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_event_at": {
          "description": "When the daemon recorded the latest event.",
          "type": "string",
          "format": "date-time"
        },
        "last_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "head_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "run_id",
        "project_id",
        "category_id",
        "category_version",
        "status",
        "started_at",
        "closed",
        "prompt_count",
        "sessions",
        "hosts",
        "milestones",
        "timing",
        "open_turns",
        "last_event_at",
        "last_seq"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "MilestoneView": {
      "type": "object",
      "properties": {
        "milestone_id": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/MilestoneOrigin"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_trust": {
          "$ref": "#/$defs/Trust"
        },
        "state": {
          "$ref": "#/$defs/MilestoneState"
        },
        "trust": {
          "description": "Highest trust any claim or verification has reached.",
          "anyOf": [
            {
              "$ref": "#/$defs/Trust"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "reached_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "counted_at": {
          "description": "When the milestone first met its required trust. This is the split.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "split": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "milestone_id",
        "origin",
        "title",
        "required_trust",
        "state",
        "evidence"
      ]
    },
    "MilestoneState": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "reached",
        "verified"
      ]
    },
    "Timing": {
      "description": "Elapsed time measured several ways, all in milliseconds since run start.",
      "type": "object",
      "properties": {
        "wall_ms": {
          "description": "Real time: wall clock since the first prompt.",
          "type": "integer",
          "format": "int64"
        },
        "timed_ms": {
          "description": "Real time minus explicit pauses.",
          "type": "integer",
          "format": "int64"
        },
        "agent_ms": {
          "description": "Time at least one agent turn was running (union across sessions), minus pauses.",
          "type": "integer",
          "format": "int64"
        },
        "human_ms": {
          "description": "Time between agent turns, each gap capped at the idle threshold, minus pauses.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "wall_ms",
        "timed_ms",
        "agent_ms",
        "human_ms"
      ]
    },
    "CategoriesResponse": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Category"
          }
        }
      },
      "required": [
        "categories"
      ]
    },
    "Category": {
      "description": "A versioned ruleset. Runs pin `(id, version)` at start so later edits to\na category never change how an old run is judged.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "milestones": {
          "description": "The run completes when every one of these counts.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MilestoneTemplate"
          }
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "description",
        "milestones"
      ]
    },
    "MilestoneTemplate": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required_trust": {
          "$ref": "#/$defs/Trust"
        },
        "suggested_evidence": {
          "description": "Evidence kinds that satisfy this milestone, as a hint to users and agents.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "key",
        "title",
        "description",
        "required_trust"
      ]
    },
    "ChainReport": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "events": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "run_id",
        "events",
        "ok"
      ]
    },
    "LiveSnapshot": {
      "description": "Every live run worth showing, as of one instant.",
      "type": "object",
      "properties": {
        "as_of": {
          "description": "The instant all `timing` values were computed at.",
          "type": "string",
          "format": "date-time"
        },
        "cursor": {
          "description": "Monotonic position in the daemon's whole log. Larger means newer;\nignore any snapshot whose cursor is lower than one already shown.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "runs": {
          "description": "Unfinished runs first, then most recently active.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveRun"
          }
        }
      },
      "required": [
        "as_of",
        "cursor",
        "runs"
      ]
    },
    "LiveRun": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "project_name": {
          "description": "Directory name of the project root, for display.",
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "$ref": "#/$defs/CategoryRef"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_event_at": {
          "type": "string",
          "format": "date-time"
        },
        "timing": {
          "description": "Clocks at `LiveSnapshot::as_of`.",
          "$ref": "#/$defs/Timing"
        },
        "running": {
          "description": "Which clocks are advancing at `as_of`.",
          "$ref": "#/$defs/RunningClocks"
        },
        "active_agents": {
          "description": "Sessions with an agent turn in progress.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "prompt_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "progress": {
          "description": "Category milestones that count, out of all category milestones.",
          "$ref": "#/$defs/Progress"
        },
        "milestones": {
          "description": "Category milestones first (in category order), then user and agent milestones.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveMilestone"
          }
        },
        "pb": {
          "description": "Best earlier completed run of the same category and version, by `timed_ms`.",
          "anyOf": [
            {
              "$ref": "#/$defs/PersonalBest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "project_id",
        "category",
        "status",
        "started_at",
        "last_event_at",
        "timing",
        "running",
        "active_agents",
        "prompt_count",
        "progress",
        "milestones"
      ]
    },
    "CategoryRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "name"
      ]
    },
    "RunningClocks": {
      "description": "A clock that is running advances 1 ms per ms after `as_of`, except\n`human`, which stops at `human_stops_at` (the idle cap).",
      "type": "object",
      "properties": {
        "wall": {
          "type": "boolean"
        },
        "timed": {
          "type": "boolean"
        },
        "agent": {
          "type": "boolean"
        },
        "human": {
          "type": "boolean"
        },
        "human_stops_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "wall",
        "timed",
        "agent",
        "human"
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "counted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "counted",
        "total"
      ]
    },
    "LiveMilestone": {
      "type": "object",
      "properties": {
        "milestone_id": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/MilestoneOrigin"
        },
        "state": {
          "$ref": "#/$defs/MilestoneState"
        },
        "trust": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trust"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_trust": {
          "$ref": "#/$defs/Trust"
        },
        "counts": {
          "description": "Reached at or above the required trust.",
          "type": "boolean"
        },
        "split": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ]
        },
        "pb_split": {
          "description": "The personal best's split for the same category milestone.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta_ms": {
          "description": "`split.timed_ms - pb_split.timed_ms`; negative is ahead of PB.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "milestone_id",
        "title",
        "origin",
        "state",
        "required_trust",
        "counts"
      ]
    },
    "PersonalBest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "project_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        }
      },
      "required": [
        "run_id",
        "timing"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
