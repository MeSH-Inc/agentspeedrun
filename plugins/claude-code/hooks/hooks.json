{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "speedrun hook claude-code user-prompt-submit", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "speedrun hook claude-code stop", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "speedrun hook claude-code session-end", "timeout": 10 }] }
    ]
  }
}
