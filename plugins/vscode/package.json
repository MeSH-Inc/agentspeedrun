{
  "name": "agentspeedrun",
  "displayName": "agentspeedrun",
  "description": "Speedrun timing for agentic coding: a live split timer, milestones, and milestone tools for VS Code's agent.",
  "version": "0.3.0",
  "publisher": "mesh-inc",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesh-inc/agentspeedrun"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.speedrun/project.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentspeedrun.init",
        "title": "Start Timing This Project",
        "category": "Speedrun",
        "icon": "$(watch)"
      },
      {
        "command": "agentspeedrun.milestone",
        "title": "Milestone Actions",
        "category": "Speedrun",
        "icon": "$(checklist)"
      },
      {
        "command": "agentspeedrun.split",
        "title": "Split (Mark Milestone Reached)",
        "category": "Speedrun",
        "icon": "$(check)"
      },
      {
        "command": "agentspeedrun.add",
        "title": "Add Milestone",
        "category": "Speedrun",
        "icon": "$(add)"
      },
      {
        "command": "agentspeedrun.accept",
        "title": "Accept Proposed Milestone",
        "category": "Speedrun",
        "icon": "$(thumbsup)"
      },
      {
        "command": "agentspeedrun.reject",
        "title": "Reject Proposed Milestone",
        "category": "Speedrun",
        "icon": "$(thumbsdown)"
      },
      {
        "command": "agentspeedrun.pause",
        "title": "Pause Run",
        "category": "Speedrun",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentspeedrun.resume",
        "title": "Resume Run",
        "category": "Speedrun",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentspeedrun.reset",
        "title": "Close Run",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.watch",
        "title": "Open Live View in Terminal",
        "category": "Speedrun",
        "icon": "$(terminal)"
      },
      {
        "command": "agentspeedrun.setupCopilotHooks",
        "title": "Time Copilot Agent Prompts (Install Hooks)",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.confirm",
        "title": "Confirm Agent Claim",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.invalidate",
        "title": "Invalidate Milestone",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.capture",
        "title": "Check Prompt Capture",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.history",
        "title": "Run History",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.publish",
        "title": "Preview and Publish Run",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.verification",
        "title": "Inspect Local Evidence Check",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.localTest",
        "title": "Run Local Test",
        "category": "Speedrun"
      },
      {
        "command": "agentspeedrun.trust",
        "title": "Trust This Project for Recording",
        "category": "Speedrun"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "agentspeedrun.splits",
          "name": "Speedrun"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentspeedrun.splits",
        "contents": "This project is not timed.\n[Start Timing This Project](command:agentspeedrun.init)",
        "when": "!agentspeedrun.tracked"
      },
      {
        "view": "agentspeedrun.splits",
        "contents": "The run starts with the first agent prompt.\n[Check recording status](command:agentspeedrun.capture)",
        "when": "agentspeedrun.tracked"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentspeedrun.add",
          "when": "view == agentspeedrun.splits && agentspeedrun.tracked",
          "group": "navigation@1"
        },
        {
          "command": "agentspeedrun.pause",
          "when": "view == agentspeedrun.splits && agentspeedrun.tracked && agentspeedrun.running",
          "group": "navigation@2"
        },
        {
          "command": "agentspeedrun.resume",
          "when": "view == agentspeedrun.splits && agentspeedrun.tracked && agentspeedrun.paused"
        },
        {
          "command": "agentspeedrun.reset",
          "when": "view == agentspeedrun.splits && agentspeedrun.tracked"
        },
        {
          "command": "agentspeedrun.history",
          "when": "view == agentspeedrun.splits && agentspeedrun.tracked"
        },
        {
          "command": "agentspeedrun.localTest",
          "when": "view == agentspeedrun.splits && agentspeedrun.tracked"
        }
      ],
      "view/item/context": [
        {
          "command": "agentspeedrun.milestone",
          "when": "view == agentspeedrun.splits",
          "group": "inline@1"
        },
        {
          "command": "agentspeedrun.verification",
          "when": "view == agentspeedrun.splits && viewItem =~ /^(reached|verified)$/"
        }
      ]
    },
    "configuration": {
      "title": "agentspeedrun",
      "properties": {
        "agentspeedrun.speedrunPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `speedrun` CLI. Empty uses `$SPEEDRUN_BIN`, then `speedrun` on `PATH`."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "agentspeedrun",
        "label": "agentspeedrun milestones"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p test/unit",
    "test": "bun test test/unit",
    "test:vscode": "npm run build && node ./out/test/run.js",
    "package": "npm run build && vsce package --no-dependencies",
    "generate:protocol": "node scripts/generate-protocol.cjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^11.0.0",
    "typescript": "^5.9.0"
  }
}
